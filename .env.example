VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-public-publishable-key
# Legacy Supabase projects may call this the anon key. Use only if your dashboard does not show a publishable key.
VITE_SUPABASE_ANON_KEY=
VITE_DEVICE_FUNCTIONS_BASE_URL=https://your-project.functions.supabase.co
VITE_OFFLINE_AUTH_LEASE_HOURS=24
VITE_GITHUB_RELEASES_URL=https://github.com/OWNER/REPO/releases

# Used by electron-builder in CI, not by the renderer.
GH_TOKEN=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=
CSC_KEY_PASSWORD=
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
